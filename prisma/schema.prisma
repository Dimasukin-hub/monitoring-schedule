generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model Land {
  id                   Int            @id @default(autoincrement())
  lokasi               String
  wilayah              String
  year                 Int?
  luasBruto            Float
  luasNetto            Float
  status               String?
  eks                  String?
  sejarah              String?
  phBk                 Float?
  phSn                 Float?
  rencBkr              String?
  rencBajak            String?
  realBkr              String?
  realBajak            String?
  aplikasiTerakhir     String?
  bulanSn              String?
  statusAplikasi       String?
  rencMulaiTanam       String?
  rencSelesaiTanam     String?
  realMulaiTanam       String?
  realSelesaiTanam     String?
  hariWaktu            Int?
  bulanTanam           String?
  bulanPanen           String?
  jenisBibit           String?
  kelasBibit           String?
  statusProduksi       String?
  stdPanen             String?
  deviasiMonth         Int?
  progressTanam        Float?         @default(0)
  aplikasiDetails      Json?
  createdAt            DateTime       @default(now())
  updatedAt            DateTime       @updatedAt
  activities           LandActivity[]
  stageStockDetails    LandStageStock[]

  @@index([lokasi])
  @@index([wilayah])
  @@index([year])
  @@index([status])
  @@index([jenisBibit])
  @@index([kelasBibit])
  @@index([bulanTanam])
}

model LandActivity {
  id            Int      @id @default(autoincrement())
  landId        Int
  land          Land     @relation(fields: [landId], references: [id], onDelete: Cascade)
  stepOrder     Int
  code          String
  name          String
  rencanaDate   String?
  realisasiDate String?
  status        String   // "COMPLETED", "IN_PROGRESS", "PENDING"
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  @@index([landId])
  @@index([code])
  @@index([status])
}

model MonthlySummary {
  id         Int      @id @default(autoincrement())
  category   String   // "Bongkar", "Tanam"
  monthYear  String
  monthIndex Int
  year       Int
  rfc        Float?
  rencana    Float?
  realisasi  Float?
  deviasi    Float?
  akumulasi  Float?
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  @@index([category])
  @@index([year, monthIndex])
}

model SeedSummary {
  id        Int      @id @default(autoincrement())
  period    String
  bibitType String
  kelas     String
  kebutuhan Float?
  potensi   Float?
  realisasi Float?
  deviasi   Float?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([period])
  @@index([bibitType])
  @@index([kelas])
}

model StageStockSummary {
  id                      Int              @id @default(autoincrement())
  year                    Int
  month                   String
  monthIndex              Int
  monthYear               String
  bongkar                 Float            @default(0)
  bajak                   Float            @default(0)
  sn                      Float            @default(0)
  tanam                   Float            @default(0)
  stokBongkar             Float            @default(0)
  stokBajak               Float            @default(0)
  stokSN                  Float            @default(0)
  totalStok               Float            @default(0)
  initialCarryoverBongkar Float?
  initialCarryoverBajak   Float?
  initialCarryoverSN      Float?
  contributingLands       LandStageStock[]
  createdAt               DateTime         @default(now())
  updatedAt               DateTime         @updatedAt

  @@unique([year, monthIndex])
  @@index([year])
}

model LandStageStock {
  id                  Int               @id @default(autoincrement())
  landId              Int
  land                Land              @relation(fields: [landId], references: [id], onDelete: Cascade)
  stageStockSummaryId Int
  stageStockSummary   StageStockSummary @relation(fields: [stageStockSummaryId], references: [id], onDelete: Cascade)
  stageType           String            // "BONGKAR" | "BAJAK" | "SN" | "TANAM"
  luasHa              Float
  eventDate           String?
  status              String            @default("COMPLETED")
  createdAt           DateTime          @default(now())
  updatedAt           DateTime          @updatedAt

  @@index([landId])
  @@index([stageStockSummaryId])
  @@index([stageType])
}

model Planting {
  id         Int      @id @default(autoincrement())
  lokasi     String
  luas       Float
  jenisBibit String?
  kelasBibit String?
  realTanam  Float?
  sisa       Float?
  estSelesai String?
  progress   Float?
  awalTanam  String?
  leadtime   Int?
  status     String?
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  @@index([lokasi])
  @@index([jenisBibit])
  @@index([kelasBibit])
  @@index([status])
}

model PlantingDetail {
  id           Int       @id @default(autoincrement())
  lokasi       String
  tanggal      String?
  tanggalDate  DateTime?
  luasNetto    Float?
  aktivitas    String?   // "Tanam Bibit" | "Petik Bibit"
  standar      Float?    @default(0)
  besar        Float?    @default(0)
  sedang       Float?    @default(0)
  kecil        Float?    @default(0)
  extraKecil   Float?    @default(0)
  total        Float     @default(0)
  jenisBibit   String?
  wilayah      String?
  awalTanam    String?
  selesaiTanam String?
  akumTanam    Float?    @default(0)
  persenTanam  Float?    @default(0)
  petikKe      String?
  sourceFile   String?   @default("Monitor Siap Nanas Update.xlsx")
  sourceSheet  String?   @default("Input Real Tanam&Petik Nanas")
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt

  @@index([lokasi])
  @@index([aktivitas])
  @@index([jenisBibit])
  @@index([tanggalDate])
}

model StokLahanMaster {
  id               Int      @id @default(autoincrement())
  lokasi           String   @unique
  wilayah          String
  luasBruto        Float
  luasNetto        Float
  status           String?
  eks              String?
  sejarah          String?
  phBk             Float?
  phSn             Float?
  aplikasiTerakhir String?
  statusAplikasi   String?
  realBajak        String?
  realBkr          String?
  realSn           String?
  realMulaiTanam   String?
  realSelesaiTanam String?
  progressTanam    Float?
  category         String?  // BK | BJK | SN | PROSES | SELESAI
  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt

  @@index([wilayah])
  @@index([status])
  @@index([category])
}

model User {
  id        Int      @id @default(autoincrement())
  name      String
  email     String   @unique
  password  String
  role      String   @default("user") // "admin" | "user"
  avatar    String?  @db.Text
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

// ==========================================
// MODUL GORONG-GORONG & MASTER DATA TERPADU
// ==========================================

model MasterStatusLokasi {
  id               Int       @id @default(autoincrement())
  lokasi           String    @unique
  strucPlant       String?
  statusLengkap    String?
  status           String?   // LEFT(statusLengkap, 4)
  luasBruto        Float?
  luasAktif        Float?
  luasNetto        Float?
  bibit            String?
  kelas            String?   // dari Jenis & Kelas.xlsx (S, M, K, dll.)
  jenis            String?   // dari Jenis & Kelas.xlsx (SC, CR, dll.)
  perubahanSts     String?
  tglRawat         DateTime?
  hari             Int?
  bulan            Int?
  umurRawat        Int?      // = umurBulan
  umurBulan        Int?
  forcingStd       DateTime? // tglRawat + hariForcing
  forcingProd2026  DateTime? // dari Update Produksi 2026 Kolom V
  forcing2027      DateTime? // dari update prod 2027 Kolom S
  ketForcing2027   String?   // dari update prod 2027 Kolom O: 'real' | 'rcn'
  fixForcing       DateTime? // IF(forcingProd2026 != null, forcingProd2026, forcingStd)
  forcingGabungan  DateTime? // IF(forcing2027 != null, forcing2027, forcingProd2026)
  umurFStd         Int?
  umurFProd        Int?
  createdAt        DateTime  @default(now())
  updatedAt        DateTime  @updatedAt

  @@index([strucPlant])
  @@index([status])
  @@index([bibit])
  @@index([kelas])
  @@index([jenis])
}

model MasterWaterlogging {
  id         Int      @id @default(autoincrement())
  no         Int?
  pg         String?  @default("PG1")
  wilayah    String?
  lokasi     String
  luasHa     Float?
  komoditas  String?
  bulanDsmBk String?
  tahunDsmBk Int?
  dsmbkPlot  String?  // Kolom J Monitor Gorong2 (DSM BK)
  dryBk      String?
  bulanDsmSt String?
  tahunDsmSt Int?
  dsmPlot    String?  // Kolom K Monitor Gorong2 (DSM ST)
  drySt      String?
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  @@index([lokasi])
  @@index([wilayah])
  @@index([dsmbkPlot])
  @@index([dsmPlot])
}

model MasterSapGorongGorong {
  id                Int      @id @default(autoincrement())
  lokasi            String   // Kolom A / Kolom S
  wilayahSap        String?  // Kolom B (AP1, dll.)
  plantCostCenter   String?  // Kolom C (PSALPG1)
  statusTanaman     String?  // Kolom D (SLDA)
  spkId             String?  // Kolom E (SPK007978176)
  pasDocument       String?  // Kolom F (LKB001086070)
  tanggalRealisasi  DateTime // Kolom G (Tanggal)
  deskripsiKegiatan String?  // Kolom H (Bantu pasang gorong2)
  deskripsiBahan    String   // Kolom I (GORONG-GORONG;Ø40CM...)
  jenisData         String?  // Kolom J (Material)
  kodeBahan         String?  // Kolom K (SSPA0204162)
  qty               Int      @default(0) // Kolom L (Jumlah terpasang)
  hasilEfektif      Float?   // Kolom M (0.4)
  totalBiaya        Float?   // Kolom N (4150000)
  penanggungJawab   String?  // Kolom O (Wilayah 4)
  waktuPelaksanaan  Float?   // Kolom P (Time)
  air               Float?   @default(0) // Kolom Q
  jumlahAir         Float?   @default(0) // Kolom R
  referensiLokasi   String?  // Kolom S (048G2)
  diameter          Int      // Helper auto-detect: 40, 60, 80, 100
  fileName          String?
  uploadedBy        String?
  createdAt         DateTime @default(now())
  updatedAt         DateTime @updatedAt

  @@index([lokasi])
  @@index([diameter])
  @@index([spkId])
  @@index([pasDocument])
  @@index([tanggalRealisasi])
}

model TransaksiGorongGorong {
  id             Int      @id @default(autoincrement())
  jenisTransaksi String   // "ORDER" | "DROP" | "PASANG_MANUAL"
  lokasi         String
  lokasiAsal     String?
  lokasiTujuan   String?
  wilayah        String?
  tanggal        DateTime @default(now())
  qtyD40         Int      @default(0) // Max 3 digit: 0-999
  qtyD60         Int      @default(0) // Max 3 digit: 0-999
  qtyD80         Int      @default(0) // Max 3 digit: 0-999
  qtyD100        Int      @default(0) // Max 3 digit: 0-999
  keterangan     String?
  createdBy      String?  // Username penginput
  userRole       String?  // "USER_WILAYAH" | "ADMIN"
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  @@index([lokasi])
  @@index([jenisTransaksi])
  @@index([tanggal])
  @@index([wilayah])
}

model LokasiOrderGorongGorong {
  id              Int      @id @default(autoincrement())
  lokasi          String   @unique
  wilayah         String?
  luas            Float?
  statusTanaman   String?
  umurBulan       Int?
  tanggalOrder    String?
  aktBk           String?
  dsmBk           String?
  dsmSt           String?
  prioritas       String?
  statusAll       String?  // 'Close' | '-'
  isClosedExcel   Boolean  @default(false)
  ratioPerHa      Float?
  keteranganClose String?

  // Diameter 40
  orderD40        Int?
  dropD40         Int?
  tglDropD40      String?
  pindahD40       Int?     @default(0)
  pasangManD40    Int?
  pasangSapD40    Int?
  statusD40       String?

  // Diameter 60
  orderD60        Int?
  dropD60         Int?
  pindahD60       Int?     @default(0)
  pasangManD60    Int?
  pasangSapD60    Int?
  statusD60       String?

  // Diameter 80
  orderD80        Int?
  dropD80         Int?
  pindahD80       Int?     @default(0)
  pasangManD80    Int?
  pasangSapD80    Int?
  statusD80       String?

  // Diameter 100
  orderD100        Int?
  dropD100         Int?
  pindahD100       Int?     @default(0)
  pasangManD100    Int?
  pasangSapD100    Int?
  statusD100       String?

  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  @@index([lokasi])
  @@index([wilayah])
  @@index([prioritas])
  @@index([statusAll])
}

model LokasiBelumOrderGorongGorong {
  id        Int      @id @default(autoincrement())
  lokasi    String   @unique
  wilayah   String?
  luasNetto Float?
  status    String?  // BK atau ST
  aktBk     String?  // Aktivitas olah tanah (misal "06. DP1", "24. Selesai Tanam")
  stepOrder Int?     // 6 s/d 20
  keterangan String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([lokasi])
  @@index([wilayah])
  @@index([stepOrder])
}

model MasterDataOrderGorongGorong {
  id           Int       @id @default(autoincrement())
  area         String?
  lokasi       String
  wilayah      String?   // Dari MasterStatusLokasi.strucPlant
  tanggal      DateTime? // Tanggal order
  diameter40   Int       @default(0)
  diameter60   Int       @default(0)
  diameter80   Int       @default(0)
  diameter100  Int       @default(0)
  lookupStatus String?   // Dari LokasiOrderGorongGorong.dsmSt
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt

  @@index([lokasi])
  @@index([wilayah])
  @@index([tanggal])
}

model MasterDataDropGorongGorong {
  id           Int       @id @default(autoincrement())
  lokasi       String
  wilayah      String?   // Dari MasterStatusLokasi.strucPlant
  tanggal      DateTime  // Hanya data tahun 2025 dan 2026, bukan 'x'
  diameter40   Int       @default(0)
  diameter60   Int       @default(0)
  diameter80   Int       @default(0)
  diameter100  Int       @default(0)
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt

  @@index([lokasi])
  @@index([wilayah])
  @@index([tanggal])
}

model MasterDataPasangManual {
  id                  Int       @id @default(autoincrement())
  lokasi              String
  wilayah             String?   // Dari MasterStatusLokasi.strucPlant
  tanggalPasangManual DateTime  // Tanggal pasang manual
  diameter40          Int       @default(0)
  diameter60          Int       @default(0)
  diameter80          Int       @default(0)
  diameter100         Int       @default(0)
  createdAt           DateTime  @default(now())
  updatedAt           DateTime  @updatedAt

  @@index([lokasi])
  @@index([wilayah])
  @@index([tanggalPasangManual])
}

model MasterDataPindahGorongGorong {
  id              Int       @id @default(autoincrement())
  lokasiPengirim  String
  wilayahPengirim String?   // Dari MasterStatusLokasi.strucPlant pengirim
  lokasiPenerima  String
  wilayahPenerima String?   // Dari MasterStatusLokasi.strucPlant penerima
  tanggal         DateTime  // Tanggal pindah lokasi / transaksi
  diameter40      Int       @default(0)
  diameter60      Int       @default(0)
  diameter80      Int       @default(0)
  diameter100     Int       @default(0)
  keterangan      String?
  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt

  @@index([lokasiPengirim])
  @@index([lokasiPenerima])
  @@index([wilayahPengirim])
  @@index([wilayahPenerima])
  @@index([tanggal])
}

// ==========================================
// MODUL SULAM & MASTER DATA TERPADU SULAM
// ==========================================

model MasterSpekBibitSulam {
  id             Int      @id @default(autoincrement())
  spekBBSulamBtg String   @unique // 1. Spek BB Sulam Btg
  cd             Int      @default(0) // 2. CD
  fuso           Int      @default(0) // 3. Fuso
  spesifikasi    String?  // 4. Spesifikasi
  keterangan     String?  // 5. Keterangan
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  @@index([spekBBSulamBtg])
}

model ListSulam {
  id                 Int       @id @default(autoincrement())
  wilayah            String?   // 1. Wilayah
  lokasi             String    @unique // 2. Lokasi
  jenisBibit         String?   // 3. Jenis Bibit
  kelasBibit         String?   // 4. Kelas Bibit
  tglRawat           DateTime? // 5. Tanggal Rawat
  tglStdForcing      DateTime? // 6. Tanggal STD Forcing
  tglFProd           DateTime? // 7. Tanggal F Prod (Forcing Prod 26)
  tglFMax            DateTime? // 8. Tanggal F Max (MAX(forcingStd, tglFProd))
  tglOrder           DateTime? // 9. Tanggal Order
  umurForcing        Int?      // 10. Umur Forcing (bulan)

  // 11. Permintaan Ritase
  permintaanJumlah   Int       @default(0) // Jumlah
  permintaanRit      Float     @default(0) // Rit
  permintaanRealRit  Float     @default(0) // Real Rit

  // 12. Monitor Drop
  dropReal           Float     @default(0) // Real
  dropTotal          Float     @default(0) // Total
  dropDev            Float     @default(0) // Dev
  dropPct            Float     @default(0) // %Drop

  // 13. Monitor Sulam
  sulamReal          Float     @default(0) // Real
  sulamManual        Float     @default(0) // Manual
  sulamSaldo         Float     @default(0) // Saldo
  sulamPct           Float?    // %Sulam
  sulamLastDate      DateTime? // Last Sulam

  // 14-17. Spek & Keterangan
  spekBibit          String?   // 14. Spek Bibit
  keteranganProses   String?   // 15. Keterangan Proses
  keteranganMati     String?   // 16. Keterangan Mati
  keteranganRitase   String?   // 17. Keterangan Ritase

  createdAt          DateTime  @default(now())
  updatedAt          DateTime  @updatedAt

  @@index([lokasi])
  @@index([wilayah])
}

model MasterDataOrderSulam {
  id               Int       @id @default(autoincrement())
  lokasi           String    // 1. Lokasi
  wilayah          String?   // 2. Wilayah
  tanggalOrder     DateTime? // 3. Tanggal Order
  jumlah           Int       @default(0) // 4. Jumlah
  rit              Float     @default(0) // 5. Rit
  realRit          Float     @default(0) // 6. Real Rit
  spekBibit        String?   // 7. Spek Bibit
  manual           Float     @default(0) // 8. Manual
  keteranganProses String?   // 9. Keterangan Proses
  keteranganMati   String?   // 10. Keterangan Mati
  keteranganRitase String?   // 11. Keterangan Ritase
  createdAt        DateTime  @default(now())
  updatedAt        DateTime  @updatedAt

  @@index([lokasi])
  @@index([wilayah])
  @@index([tanggalOrder])
}

model MasterDataDropBibitSulam {
  id           Int       @id @default(autoincrement())
  lokasi       String    // 1. Lokasi
  hasilHa      Float?    // 2. Hasil Ha
  hasilBtg     Int       @default(0) // 3. Hasil Btg
  tanggal      DateTime? // 4. Tanggal
  bibitOrdered String?   // 5. Bibit Ordered
  stdRit       Int?      // 6. Std Rit
  jumlahRit    Int?      // 7. Jumlah Rit
  jenisUnit    String?   // 8. Jenis Unit
  tanggalOrder DateTime? // 9. Tanggal Order
  statusDrop   String?   // 10. Status Drop
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt

  @@index([lokasi])
  @@index([tanggal])
  @@index([tanggalOrder])
}

model MasterDataRealSulam {
  id           Int       @id @default(autoincrement())
  lokasi       String
  hasilHa      Float?
  hasilBtg     Int       @default(0)
  tanggal      DateTime?
  bibitOrdered String?   // Spek BB dari List Sulam
  stdRit       Int?      // Nilai CD dari MasterSpekBibitSulam
  ritPlanted   Int?      // CEILING(hasilBtg / stdRit)
  keterangan   String?
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt

  @@index([lokasi])
  @@index([tanggal])
}

model FormTiketOrderSulam {
  id             Int       @id @default(autoincrement())
  nomorTiket     String    @unique // SLM-YYYYMM-XXXX
  lokasi         String
  wilayah        String?
  usia           Int?      // Umur Forcing dalam bulan: Math.round((today - tglFMax)/30.4)
  kelasBibit     String    // Gabungan jenis bibit & kelas bibit (contoh: "Sucker No. 2")
  ritFuso        Int       @default(0)
  ritCD          Int       @default(0)
  keterangan     String?   // Keterangan pangkas produksi, dll.
  status         String    @default("DIAJUKAN") // DIAJUKAN -> APPROVED -> ANTRIAN -> REAL_DROP -> REAL_TANAM -> CLOSE
  pemohonName    String?
  pemohonRole    String?
  approvedByName String?
  approvedAt     DateTime?
  catatan        String?
  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt

  @@index([lokasi])
  @@index([wilayah])
  @@index([status])
  @@index([createdAt])
}


