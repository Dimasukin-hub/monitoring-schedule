generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model Land {
  id                   Int            @id @default(autoincrement())
  lokasi               String
  wilayah              String
  year                 Int?
  luasBruto            Float
  luasNetto            Float
  status               String?
  eks                  String?
  sejarah              String?
  phBk                 Float?
  phSn                 Float?
  rencBkr              String?
  rencBajak            String?
  realBkr              String?
  realBajak            String?
  aplikasiTerakhir     String?
  bulanSn              String?
  statusAplikasi       String?
  rencMulaiTanam       String?
  rencSelesaiTanam     String?
  realMulaiTanam       String?
  realSelesaiTanam     String?
  hariWaktu            Int?
  bulanTanam           String?
  bulanPanen           String?
  jenisBibit           String?
  kelasBibit           String?
  statusProduksi       String?
  stdPanen             String?
  deviasiMonth         Int?
  progressTanam        Float?         @default(0)
  aplikasiDetails      Json?
  createdAt            DateTime       @default(now())
  updatedAt            DateTime       @updatedAt
  activities           LandActivity[]
  stageStockDetails    LandStageStock[]

  @@index([lokasi])
  @@index([wilayah])
  @@index([year])
  @@index([status])
  @@index([jenisBibit])
  @@index([kelasBibit])
  @@index([bulanTanam])
}

model LandActivity {
  id            Int      @id @default(autoincrement())
  landId        Int
  land          Land     @relation(fields: [landId], references: [id], onDelete: Cascade)
  stepOrder     Int
  code          String
  name          String
  rencanaDate   String?
  realisasiDate String?
  status        String   // "COMPLETED", "IN_PROGRESS", "PENDING"
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  @@index([landId])
  @@index([code])
  @@index([status])
}

model MonthlySummary {
  id         Int      @id @default(autoincrement())
  category   String   // "Bongkar", "Tanam"
  monthYear  String
  monthIndex Int
  year       Int
  rfc        Float?
  rencana    Float?
  realisasi  Float?
  deviasi    Float?
  akumulasi  Float?
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  @@index([category])
  @@index([year, monthIndex])
}

model SeedSummary {
  id        Int      @id @default(autoincrement())
  period    String
  bibitType String
  kelas     String
  kebutuhan Float?
  potensi   Float?
  realisasi Float?
  deviasi   Float?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([period])
  @@index([bibitType])
  @@index([kelas])
}

model StageStockSummary {
  id                      Int              @id @default(autoincrement())
  year                    Int
  month                   String
  monthIndex              Int
  monthYear               String
  bongkar                 Float            @default(0)
  bajak                   Float            @default(0)
  sn                      Float            @default(0)
  tanam                   Float            @default(0)
  stokBongkar             Float            @default(0)
  stokBajak               Float            @default(0)
  stokSN                  Float            @default(0)
  totalStok               Float            @default(0)
  initialCarryoverBongkar Float?
  initialCarryoverBajak   Float?
  initialCarryoverSN      Float?
  contributingLands       LandStageStock[]
  createdAt               DateTime         @default(now())
  updatedAt               DateTime         @updatedAt

  @@unique([year, monthIndex])
  @@index([year])
}

model LandStageStock {
  id                  Int               @id @default(autoincrement())
  landId              Int
  land                Land              @relation(fields: [landId], references: [id], onDelete: Cascade)
  stageStockSummaryId Int
  stageStockSummary   StageStockSummary @relation(fields: [stageStockSummaryId], references: [id], onDelete: Cascade)
  stageType           String            // "BONGKAR" | "BAJAK" | "SN" | "TANAM"
  luasHa              Float
  eventDate           String?
  status              String            @default("COMPLETED")
  createdAt           DateTime          @default(now())
  updatedAt           DateTime          @updatedAt

  @@index([landId])
  @@index([stageStockSummaryId])
  @@index([stageType])
}

model Planting {
  id         Int      @id @default(autoincrement())
  lokasi     String
  luas       Float
  jenisBibit String?
  kelasBibit String?
  realTanam  Float?
  sisa       Float?
  estSelesai String?
  progress   Float?
  awalTanam  String?
  leadtime   Int?
  status     String?
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  @@index([lokasi])
  @@index([jenisBibit])
  @@index([kelasBibit])
  @@index([status])
}

model PlantingDetail {
  id           Int       @id @default(autoincrement())
  lokasi       String
  tanggal      String?
  tanggalDate  DateTime?
  luasNetto    Float?
  aktivitas    String?   // "Tanam Bibit" | "Petik Bibit"
  standar      Float?    @default(0)
  besar        Float?    @default(0)
  sedang       Float?    @default(0)
  kecil        Float?    @default(0)
  extraKecil   Float?    @default(0)
  total        Float     @default(0)
  jenisBibit   String?
  wilayah      String?
  awalTanam    String?
  selesaiTanam String?
  akumTanam    Float?    @default(0)
  persenTanam  Float?    @default(0)
  petikKe      String?
  sourceFile   String?   @default("Monitor Siap Nanas Update.xlsx")
  sourceSheet  String?   @default("Input Real Tanam&Petik Nanas")
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt

  @@index([lokasi])
  @@index([aktivitas])
  @@index([jenisBibit])
  @@index([tanggalDate])
}

model StokLahanMaster {
  id               Int      @id @default(autoincrement())
  lokasi           String   @unique
  wilayah          String
  luasBruto        Float
  luasNetto        Float
  status           String?
  eks              String?
  sejarah          String?
  phBk             Float?
  phSn             Float?
  aplikasiTerakhir String?
  statusAplikasi   String?
  realBajak        String?
  realBkr          String?
  realSn           String?
  realMulaiTanam   String?
  realSelesaiTanam String?
  progressTanam    Float?
  category         String?  // BK | BJK | SN | PROSES | SELESAI
  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt

  @@index([wilayah])
  @@index([status])
  @@index([category])
}

model User {
  id        Int      @id @default(autoincrement())
  name      String
  email     String   @unique
  password  String
  role      String   @default("user") // "admin" | "user"
  avatar    String?  @db.Text
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

// ==========================================
// MODUL GORONG-GORONG & MASTER DATA TERPADU
// ==========================================

model MasterStatusLokasi {
  id               Int       @id @default(autoincrement())
  lokasi           String    @unique
  wil              String?
  strucPlant       String?
  statusLengkap    String?
  status           String?   // LEFT(statusLengkap, 4)
  luasBruto        Float?
  luasAktif        Float?
  luasNetto        Float?
  bibit            String?
  kelas            String?   // dari Jenis & Kelas.xlsx (S, M, K, dll.)
  jenis            String?   // dari Jenis & Kelas.xlsx (SC, CR, dll.)
  perubahanSts     String?
  tglRawat         DateTime?
  hari             Int?
  bulan            Int?
  umurRawat        Int?      // = umurBulan
  umurBulan        Int?
  forcingStd       DateTime? // tglRawat + hariForcing
  forcingProd2026  DateTime? // dari Update Produksi 2026 Kolom V
  forcing2027      DateTime? // dari update prod 2027 Kolom S
  ketForcing2027   String?   // dari update prod 2027 Kolom O: 'real' | 'rcn'
  fixForcing       DateTime? // IF(forcingProd2026 != null, forcingProd2026, forcingStd)
  forcingGabungan  DateTime? // IF(forcing2027 != null, forcing2027, forcingProd2026)
  umurFStd         Int?
  umurFProd        Int?
  createdAt        DateTime  @default(now())
  updatedAt        DateTime  @updatedAt

  @@index([wil])
  @@index([status])
  @@index([bibit])
  @@index([kelas])
  @@index([jenis])
}

model MasterWaterlogging {
  id         Int      @id @default(autoincrement())
  no         Int?
  pg         String?  @default("PG1")
  wilayah    String?
  lokasi     String
  luasHa     Float?
  komoditas  String?
  bulanDsmBk String?
  tahunDsmBk Int?
  dsmbkPlot  String?  // Kolom J Monitor Gorong2 (DSM BK)
  dryBk      String?
  bulanDsmSt String?
  tahunDsmSt Int?
  dsmPlot    String?  // Kolom K Monitor Gorong2 (DSM ST)
  drySt      String?
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  @@index([lokasi])
  @@index([wilayah])
  @@index([dsmbkPlot])
  @@index([dsmPlot])
}

model MasterSapGorongGorong {
  id                Int      @id @default(autoincrement())
  lokasi            String   // Kolom A / Kolom S
  wilayahSap        String?  // Kolom B (AP1, dll.)
  plantCostCenter   String?  // Kolom C (PSALPG1)
  statusTanaman     String?  // Kolom D (SLDA)
  spkId             String?  // Kolom E (SPK007978176)
  pasDocument       String?  // Kolom F (LKB001086070)
  tanggalRealisasi  DateTime // Kolom G (Tanggal)
  deskripsiKegiatan String?  // Kolom H (Bantu pasang gorong2)
  deskripsiBahan    String   // Kolom I (GORONG-GORONG;Ø40CM...)
  jenisData         String?  // Kolom J (Material)
  kodeBahan         String?  // Kolom K (SSPA0204162)
  qty               Int      @default(0) // Kolom L (Jumlah terpasang)
  hasilEfektif      Float?   // Kolom M (0.4)
  totalBiaya        Float?   // Kolom N (4150000)
  penanggungJawab   String?  // Kolom O (Wilayah 4)
  waktuPelaksanaan  Float?   // Kolom P (Time)
  air               Float?   @default(0) // Kolom Q
  jumlahAir         Float?   @default(0) // Kolom R
  referensiLokasi   String?  // Kolom S (048G2)
  diameter          Int      // Helper auto-detect: 40, 60, 80, 100
  fileName          String?
  uploadedBy        String?
  createdAt         DateTime @default(now())
  updatedAt         DateTime @updatedAt

  @@index([lokasi])
  @@index([diameter])
  @@index([spkId])
  @@index([pasDocument])
  @@index([tanggalRealisasi])
}

model TransaksiGorongGorong {
  id             Int      @id @default(autoincrement())
  jenisTransaksi String   // "ORDER" | "DROP" | "PASANG_MANUAL"
  lokasi         String
  wilayah        String?
  tanggal        DateTime @default(now())
  qtyD40         Int      @default(0) // Max 3 digit: 0-999
  qtyD60         Int      @default(0) // Max 3 digit: 0-999
  qtyD80         Int      @default(0) // Max 3 digit: 0-999
  qtyD100        Int      @default(0) // Max 3 digit: 0-999
  keterangan     String?
  createdBy      String?  // Username penginput
  userRole       String?  // "USER_WILAYAH" | "ADMIN"
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  @@index([lokasi])
  @@index([jenisTransaksi])
  @@index([tanggal])
  @@index([wilayah])
}